# Salin ke .env.local — pola sama seperti companyprofile
# cp .env.example .env.local

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (Dashboard → API → service_role) — jangan expose ke browser
SUPABASE_SERVICE_ROLE_KEY=

# Auth URL app
AUTH_URL=http://localhost:3000
# Vercel: https://your-app.vercel.app

# Storage opsional (S3/R2/MinIO). Kosong = ./uploads (dev lokal)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=manajeman-ft
MINIO_REGION=us-east-1
LOCAL_UPLOAD_DIR=
