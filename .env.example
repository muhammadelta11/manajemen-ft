# PostgreSQL (Laragon)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/manajeman_ft?schema=public"

# Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-secret-panjang"
AUTH_TRUST_HOST=true
