# Salin ke .env.local — pola sama seperti companyprofile
# cp .env.example .env.local

# Supabase → Project Settings → API
# Project URL saja — JANGAN pakai .../rest/v1/
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Dashboard: "Publishable key" (boleh juga NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Dashboard: "Secret key" — server only, jangan expose ke browser
# (alias lama: SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=

# Auth URL app
AUTH_URL=http://localhost:3000
# Vercel: https://your-app.vercel.app

# Storage opsional (S3/R2/MinIO). Kosong = ./uploads (dev lokal)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=manajeman-ft
MINIO_REGION=us-east-1
LOCAL_UPLOAD_DIR=
