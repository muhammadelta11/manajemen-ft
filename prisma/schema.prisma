generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  admin_arsip
  admin_kepegawaian
  pegawai
  pimpinan
}

enum JenisPegawai {
  dosen
  tendik
}

enum JabatanStruktural {
  dekan
  wd1
  wd2
  wd3
}

enum JenisSurat {
  masuk
  keluar
}

enum SuratStatus {
  tercatat
  menunggu_disposisi
  didisposisi
  ditindaklanjuti
  selesai
  arsip
}

enum DisposisiStatus {
  belum
  proses
  diteruskan
  selesai
  dibatalkan
}

enum KategoriAktivitas {
  pengajaran
  penelitian
  pengabdian
  administrasi
}

enum PeranAktivitas {
  ketua
  anggota
  pengampu
  lainnya
}

enum StatusValidasi {
  draft
  menunggu
  revisi
  disetujui
  dibatalkan
}

enum SemesterJenis {
  ganjil
  genap
  pendek
}

model Prodi {
  id        String   @id @default(cuid())
  kodeProdi String   @unique @map("kode_prodi")
  namaProdi String   @map("nama_prodi")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]
  aktivitas AktivitasPegawai[]

  @@map("prodi")
}

model TahunAkademik {
  id             String     @id @default(cuid())
  kode           String     @unique
  tanggalMulai   DateTime   @map("tanggal_mulai") @db.Date
  tanggalSelesai DateTime   @map("tanggal_selesai") @db.Date
  isAktif        Boolean    @default(false) @map("is_aktif")
  semesters      Semester[]

  @@map("tahun_akademik")
}

model Semester {
  id              String        @id @default(cuid())
  tahunAkademikId String        @map("tahun_akademik_id")
  jenis           SemesterJenis
  label           String
  isAktif         Boolean       @default(false) @map("is_aktif")

  tahunAkademik TahunAkademik      @relation(fields: [tahunAkademikId], references: [id])
  aktivitas     AktivitasPegawai[]

  @@map("semester")
}

model KategoriSurat {
  id        String  @id @default(cuid())
  kode      String  @unique
  nama      String
  deskripsi String?
  isActive  Boolean @default(true) @map("is_active")
  surat     Surat[]

  @@map("kategori_surat")
}

model User {
  id                 String              @id @default(cuid())
  name               String              @map("nama")
  email              String              @unique
  emailVerified      DateTime?           @map("email_verified")
  image              String?
  passwordHash       String?             @map("password_hash")
  nidnNip            String              @unique @map("nidn_nip")
  role               Role
  jenisPegawai       JenisPegawai?       @map("jenis_pegawai")
  jabatanStruktural  JabatanStruktural?  @map("jabatan_struktural")
  prodiId            String?             @map("prodi_id")
  isKaprodi          Boolean             @default(false) @map("is_kaprodi")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  prodi              Prodi?              @relation(fields: [prodiId], references: [id])
  accounts           Account[]
  sessions           Session[]
  suratDibuat        Surat[]             @relation("SuratCreatedBy")
  disposisiDari      Disposisi[]         @relation("DisposisiDari")
  disposisiTujuan    Disposisi[]         @relation("DisposisiTujuan")
  aktivitas          AktivitasPegawai[]  @relation("AktivitasPemilik")
  aktivitasValidasi  AktivitasPegawai[]  @relation("AktivitasValidator")
  validasiLogs       AktivitasValidasiLog[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  auditLogs          AuditLog[]
  settingsUpdated    SystemSetting[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Surat {
  id                 String       @id @default(cuid())
  jenisSurat         JenisSurat   @map("jenis_surat")
  kategoriSuratId    String?      @map("kategori_surat_id")
  nomorSurat         String       @map("nomor_surat")
  tahunNomor         Int          @map("tahun_nomor")
  tanggalSurat       DateTime     @map("tanggal_surat") @db.Date
  tanggalTerimaKirim DateTime     @map("tanggal_terima_kirim") @db.Date
  asalTujuan         String       @map("asal_tujuan")
  perihal            String
  ringkasan          String?      @db.Text
  butuhDisposisi     Boolean      @default(false) @map("butuh_disposisi")
  fileArsipKey       String?      @map("file_arsip_key")
  fileArsipMime      String?      @map("file_arsip_mime")
  fileArsipSize      Int?         @map("file_arsip_size")
  fileArsipChecksum  String?      @map("file_arsip_checksum")
  status             SuratStatus  @default(tercatat)
  createdById        String       @map("created_by")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  kategori  KategoriSurat? @relation(fields: [kategoriSuratId], references: [id])
  createdBy User           @relation("SuratCreatedBy", fields: [createdById], references: [id])
  disposisi Disposisi[]

  @@unique([jenisSurat, tahunNomor, nomorSurat])
  @@index([status])
  @@index([tanggalSurat])
  @@map("surat")
}

model Disposisi {
  id                  String          @id @default(cuid())
  suratId             String          @map("surat_id")
  parentDisposisiId   String?         @map("parent_disposisi_id")
  depth               Int             @default(1)
  dariUserId          String          @map("dari_user_id")
  tujuanUserId        String          @map("tujuan_user_id")
  tujuanJabatan       String?         @map("tujuan_jabatan")
  catatanDisposisi    String          @map("catatan_disposisi") @db.Text
  batasWaktu          DateTime?       @map("batas_waktu") @db.Date
  statusTindakLanjut  DisposisiStatus @default(belum) @map("status_tindak_lanjut")
  catatanTindakLanjut String?         @map("catatan_tindak_lanjut") @db.Text
  selesaiAt           DateTime?       @map("selesai_at")
  createdAt           DateTime        @default(now()) @map("created_at")

  surat     Surat      @relation(fields: [suratId], references: [id])
  parent    Disposisi? @relation("DisposisiChain", fields: [parentDisposisiId], references: [id])
  children  Disposisi[] @relation("DisposisiChain")
  dariUser  User       @relation("DisposisiDari", fields: [dariUserId], references: [id])
  tujuanUser User      @relation("DisposisiTujuan", fields: [tujuanUserId], references: [id])

  @@index([tujuanUserId, statusTindakLanjut])
  @@map("disposisi")
}

model AktivitasPegawai {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  prodiId          String            @map("prodi_id")
  kategori         KategoriAktivitas
  judulKegiatan    String            @map("judul_kegiatan")
  tanggalKegiatan  DateTime          @map("tanggal_kegiatan") @db.Date
  semesterId       String?           @map("semester_id")
  peran            PeranAktivitas
  deskripsi        String?           @db.Text
  buktiFileKey     String?           @map("bukti_file_key")
  buktiFileMime    String?           @map("bukti_file_mime")
  buktiFileSize    Int?              @map("bukti_file_size")
  buktiUrl         String?           @map("bukti_url")
  statusValidasi   StatusValidasi    @default(draft) @map("status_validasi")
  catatanValidator String?           @map("catatan_validator") @db.Text
  divalidasiOlehId String?           @map("divalidasi_oleh")
  divalidasiAt     DateTime?         @map("divalidasi_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  user           User                   @relation("AktivitasPemilik", fields: [userId], references: [id])
  prodi          Prodi                  @relation(fields: [prodiId], references: [id])
  semester       Semester?              @relation(fields: [semesterId], references: [id])
  divalidasiOleh User?                  @relation("AktivitasValidator", fields: [divalidasiOlehId], references: [id])
  validasiLogs   AktivitasValidasiLog[]

  @@index([prodiId, statusValidasi])
  @@map("aktivitas_pegawai")
}

model AktivitasValidasiLog {
  id          String          @id @default(cuid())
  aktivitasId String          @map("aktivitas_id")
  dariStatus  StatusValidasi  @map("dari_status")
  keStatus    StatusValidasi  @map("ke_status")
  validatorId String?         @map("validator_id")
  catatan     String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")

  aktivitas AktivitasPegawai @relation(fields: [aktivitasId], references: [id], onDelete: Cascade)
  validator User?            @relation(fields: [validatorId], references: [id])

  @@map("aktivitas_validasi_log")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tipe      String
  judul     String
  pesan     String    @db.Text
  linkPath  String?   @map("link_path")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String   @map("actor_id")
  aksi      String
  entitas   String
  entitasId String?  @map("entitas_id")
  sebelum   Json?
  sesudah   Json?
  alasan    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  updater User? @relation(fields: [updatedBy], references: [id])

  @@map("system_settings")
}
